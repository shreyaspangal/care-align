# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit real keys.

# Supabase — get from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never expose to browser

# Vercel Blob — get from Vercel dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=            # server only

# Anthropic — get from console.anthropic.com → API Keys (required for production)
ANTHROPIC_API_KEY=                # server only

# OpenRouter — get from openrouter.ai/keys (required for development / free testing)
OPENROUTER_API_KEY=               # server only

# Upstash Redis — get from console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=           # server only
UPSTASH_REDIS_REST_TOKEN=         # server only

# Google Maps — get from console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API. Without this key the hospital field works as a plain text input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # browser-safe — only Places API calls, no billing without quota

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_MODEL_TIER=development         # development = OpenRouter free model, production = Anthropic Sonnet
