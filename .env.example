# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit real keys.

# Supabase — get from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never expose to browser

# Vercel Blob — get from Vercel dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=            # server only

# Anthropic — get from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=                # server only

# Upstash Redis — get from console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=           # server only
UPSTASH_REDIS_REST_TOKEN=         # server only

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_MODEL_TIER=development         # development = Haiku (~20x cheaper), production = Sonnet
