# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit real keys.
# Every service here has a decision record in docs/DECISIONS.md.

# Supabase (D-002) — new v2 project; get from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never expose to browser

# File storage: Supabase Storage private 'documents' bucket (D-003) — uses the
# Supabase keys above, no separate credential.

# Anthropic (D-004) — console.anthropic.com → API Keys (production tier)
ANTHROPIC_API_KEY=                # server only

# OpenRouter — openrouter.ai/keys (development / free-tier testing)
OPENROUTER_API_KEY=               # server only

# Upstash Redis — console.upstash.com → REST API (rate limiting, kept from chassis)
UPSTASH_REDIS_REST_URL=           # server only
UPSTASH_REDIS_REST_TOKEN=         # server only

# PostHog (D-007) — Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN= # browser-safe project token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com  # EU project 215321; browser hits /ingest proxy

# Resend (D-006) — resend.com/api-keys (appointment reminders, Phase 4)
RESEND_API_KEY=                   # server only

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_MODEL_TIER=development         # development = cheap tier, production = capable tier (lib/ai/models.ts)
